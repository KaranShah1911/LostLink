# Copy to .env and set the URL of the LostLink backend (no trailing slash, no /api).
#
# Android emulator (backend running on this computer):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Physical Android phone on the same Wi-Fi (use your computer's LAN IP, find it with: hostname -I):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
#
# Restart Expo with "npx expo start --clear" after changing this value.
EXPO_PUBLIC_API_URL=
