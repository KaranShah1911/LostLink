# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include a database name, e.g. ...mongodb.net/lostlink?retryWrites=true&w=majority
MONGODB_URI=
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=5000

# Cloudinary dashboard > Settings > API Keys. Optional: reports without images work without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by "npm run seed:admin" to create the administrator account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
